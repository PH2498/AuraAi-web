NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
API_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://aura:aura_dev@localhost:5432/aura
AUTH_SECRET=replace-me
ENCRYPTION_KEY=replace-with-32-byte-key-placeholder
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# 至少配置一个真实模型 Provider。Phase 1 不读取这些密钥。
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 库里还没有用户时，用这两个值创建第一个账号。留空则不创建。不要把真实密码提交进仓库。
AURA_BOOTSTRAP_EMAIL=
AURA_BOOTSTRAP_PASSWORD=

# 生产环境（docker compose -f docker-compose.prod.yml）另需：
# POSTGRES_PASSWORD  不能用 aura_dev
# AUTH_SECRET        至少 24 位，不能用 replace-me
# ENCRYPTION_KEY     至少 32 位，不能含 placeholder
# CORS_ORIGINS       例如 https://localhost，不能是 *
# AURA_HOST          Caddy 对外主机名，默认 localhost，证书是内部证书
# 生产日志是 JSON，写到标准输出。会去掉 cookie、密码和反馈正文。
